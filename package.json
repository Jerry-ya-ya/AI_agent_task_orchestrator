{
  "name": "ai-agent-task-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop task orchestrator for Codex CLI",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "pnpm desktop:dev",
    "dev:web": "concurrently --kill-others-on-fail \"cross-env ORCHESTRATOR_PORT=4317 tsx src/backend/standalone.ts\" \"ng serve --host 127.0.0.1 --port 4300\"",
    "desktop:dev": "tauri dev",
    "dev:frontend": "ng serve --host 127.0.0.1 --port 4300",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "ng build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:sidecar": "pnpm build:backend && node scripts/build-sidecar.mjs",
    "start": "node scripts/start-desktop.mjs",
    "icons:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-app-icon.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "tauri build --no-bundle",
    "dist": "tauri build"
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@tauri-apps/api": "2.12.4",
    "cytoscape": "3.34.3",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.5.2",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/supertest": "6.0.3",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
