{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/main",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src/backend/**/*.ts",
    "src/electron/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
